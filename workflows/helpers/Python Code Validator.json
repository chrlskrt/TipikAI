    "When Executed by Another Workflow": [
      {
        "json": {
          "python_code": "import os, shutil\nimport kagglehub\n\nproject_root = r\"/home/chrlskrt/specprob/output/MicrosoftCatsvsDogsDataset\"\ndataset_dir = os.path.join(project_root, \"dataset\")\nos.makedirs(dataset_dir, exist_ok=True)\n\nslug = \"shaunthesheep/microsoft-catsvsdogs-dataset\"\n\ndef write_log(message):\n    log_path = os.path.join(project_root, \"artifacts\", \"acquire_dataset.log\")\n    os.makedirs(os.path.dirname(log_path), exist_ok=True)\n    with open(log_path, \"a\", encoding=\"utf-8\") as f:\n        f.write(message + \"\\n\")\n\nwrite_log(\"Starting dataset acquisition...\")\n\nif os.listdir(dataset_dir):\n    write_log(\"Dataset directory is not empty; skipping download.\")\nelse:\n    try:\n        download_path = kagglehub.dataset_download(slug)\n        write_log(\"Downloaded to: \" + str(download_path))\n\n        def copy_into(src, dst_dir):\n            if os.path.isdir(src):\n                for root, _, files in os.walk(src):\n                    for file_name in files:\n                        s = os.path.join(root, file_name)\n                        rel = os.path.relpath(s, src)\n                        d = os.path.join(dst_dir, rel)\n                        os.makedirs(os.path.dirname(d), exist_ok=True)\n                        if not os.path.exists(d):\n                            shutil.copy2(s, d)\n            else:\n                d = os.path.join(dst_dir, os.path.basename(src))\n                if not os.path.exists(d):\n                    shutil.copy2(src, d)\n\n        copy_into(download_path, dataset_dir)\n        write_log(\"Files now in dataset_dir: \" + \", \".join(os.listdir(dataset_dir)[:20]))\n    except Exception as e:\n        write_log(\"Error during download: \" + str(e))\n"
        },
        "pairedItem": {
          "item": 0
        }
      }
    ]
