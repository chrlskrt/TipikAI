# ===================================
# Backend API Environment Variables
# ===================================

# Server
NODE_ENV=development
PORT=8000

# CORS - Add your frontend URLs (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
# Production example:
# CORS_ORIGIN=https://tipikai.vercel.app,https://www.tipikai.com

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/tipikai

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# n8n Integration
USE_N8N=true
N8N_BASE_URL=https://your-n8n-url.ngrok-free.dev
N8N_WEBHOOK_SECRET=your-webhook-secret
N8N_MODEL_EXECUTION_ENDPOINT=/webhook/model-execution
